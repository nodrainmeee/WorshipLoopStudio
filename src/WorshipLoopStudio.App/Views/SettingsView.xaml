<UserControl x:Class="WorshipLoopStudio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="AUDIO OUTPUT" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Driver" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}" Margin="0,0,0,10" AutomationProperties.Name="Audio driver" />
                    <TextBlock Text="Output device" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                ToolTip="Refresh device list" AutomationProperties.Name="Refresh devices">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                        </Button>
                        <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedDevice}" AutomationProperties.Name="Output device" />
                    </DockPanel>
                    <TextBlock Text="Buffer size (latency, ms)" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding LatencyOptions}" SelectedItem="{Binding SelectedLatency}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,6"
                              AutomationProperties.Name="Buffer size" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,10">
                        Smaller buffers make pads and live triggering feel tighter but need a faster computer. If you hear crackles or dropouts,
                        choose a larger buffer. 30-60 ms is a safe range for live services with WASAPI shared mode.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ApplyAudioCommand}" Content="Apply audio settings" Style="{StaticResource PrimaryButton}" />
                        <TextBlock Text="{Binding AudioStatus}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="480" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="STORAGE" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Folder in use" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding DataRoot}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding DiskFreeText}" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="Configured folder (used at next start)" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding ConfiguredDataRoot}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,10">
                        Subfolders: Projects, Loops, Recordings, Samples, SeparatedStems, Models, Logs, Exports.
                    </TextBlock>
                    <WrapPanel>
                        <Button Command="{Binding OpenDataFolderCommand}" Content="Open folder" Margin="0,0,6,6" />
                        <Button Command="{Binding ChangeDataRootCommand}" Content="Choose another location..." Margin="0,0,6,6" />
                        <Button Command="{Binding ResetDataRootCommand}" Content="Use default location" Margin="0,0,6,6" />
                        <Button Command="{Binding OpenLogsCommand}" Content="Open logs" Margin="0,0,6,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="STARTER LIBRARY" Style="{StaticResource SectionTitle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,10">
                        The built-in percussion sounds (gangan talking drum, djembe, shekere, agogo, African bells, gongs, kit, cymbals and shakers)
                        are synthesized by Worship Loop Studio itself and are free to use in any service or recording.
                    </TextBlock>
                    <Button Command="{Binding RegenerateSamplesCommand}" Content="Rebuild starter samples" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
