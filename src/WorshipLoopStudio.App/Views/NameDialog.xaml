<Window x:Class="WorshipLoopStudio.App.Views.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" />
        <TextBox x:Name="ValueBox" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" Visibility="Collapsed"
                   Text="Please enter a name." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
