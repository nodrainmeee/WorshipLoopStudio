<UserControl x:Class="WorshipLoopStudio.App.Views.RecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WorshipLoopStudio.App.Controls">
    <Grid Margin="0,8,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Input & recording ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="INPUT" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Recording device (microphone or audio interface)" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                    ToolTip="Refresh device list" AutomationProperties.Name="Refresh devices">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                            </Button>
                            <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}" AutomationProperties.Name="Recording device" />
                        </DockPanel>
                        <Button Command="{Binding OpenInputCommand}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE720;" Margin="0,0,6,0" /><TextBlock Text="Open input" /></StackPanel>
                        </Button>
                        <TextBlock Text="{Binding InputStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,10" />

                        <TextBlock Text="Input level" Style="{StaticResource FieldLabel}" />
                        <Grid Height="14" Margin="0,0,0,4">
                            <Border Background="{StaticResource MutedBrush}" CornerRadius="4" />
                            <Border HorizontalAlignment="Left" CornerRadius="4" Width="{Binding InputLevel, Converter={StaticResource LevelToWidth}, ConverterParameter=348}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClipping}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                        <TextBlock Text="CLIPPING: lower the input gain" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Visibility="{Binding IsClipping, Converter={StaticResource BoolToVisibility}}" />

                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding InputGainText}" Width="64" TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Text="Input gain" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                        <Slider Minimum="-24" Maximum="24" Value="{Binding InputGainDb}" TickFrequency="6" IsSnapToTickEnabled="False" AutomationProperties.Name="Input gain" />
                        <CheckBox IsChecked="{Binding MonitorEnabled}" Content="Monitor input through the speakers (use headphones to avoid feedback)" Margin="0,10,0,0"
                                  Foreground="{StaticResource ForegroundBrush}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Command="{Binding OpenPrivacySettingsCommand}" Content="Microphone privacy settings" Style="{StaticResource GhostButton}" />
                            <Button Command="{Binding OpenSoundSettingsCommand}" Content="Windows sound settings" Style="{StaticResource GhostButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RECORD" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Length" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding DurationModes}" SelectedItem="{Binding SelectedDurationMode}" Margin="0,0,0,8" AutomationProperties.Name="Recording length mode" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsSecondsMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=LostFocus}" Width="80" AutomationProperties.Name="Recording length in seconds" />
                            <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsBarsMode, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox ItemsSource="{Binding BarChoices}" SelectedItem="{Binding DurationBars}" Width="80" AutomationProperties.Name="Recording length in bars" />
                            <TextBlock Text="bars at the project tempo" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding StartPlaybackWithRecording}" Content="Start the loop playback when recording starts" Margin="0,0,0,12"
                                  Foreground="{StaticResource ForegroundBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding StartRecordingCommand}" Style="{StaticResource BigDangerButton}" Margin="0,0,8,0" AutomationProperties.Name="Start recording">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE7C8;" Margin="0,0,8,0" /><TextBlock Text="RECORD" FontSize="15" /></StackPanel>
                            </Button>
                            <Button Command="{Binding StopRecordingCommand}" MinHeight="44" Padding="18,8" AutomationProperties.Name="Stop recording">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" Margin="0,0,8,0" /><TextBlock Text="STOP" FontSize="15" /></StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ElapsedText}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"
                                       FontFamily="Consolas" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Recordings & clip editor ============ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="220" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding ImportAudioCommand}" Content="Import audio file..." Margin="0,0,6,0" ToolTip="Bring an existing audio file into the editor" />
                            <Button Command="{Binding ShowInFolderCommand}" Content="Show in folder" Margin="0,0,6,0" />
                            <Button Command="{Binding DeleteRecordingCommand}" Content="Delete" />
                        </StackPanel>
                        <TextBlock Text="RECORDINGS" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording}" Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="Recordings">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedForegroundBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CLIP EDITOR: TRIM AND SET LOOP POINTS" Style="{StaticResource SectionTitle}" />
                    <TextBlock DockPanel.Dock="Top" Text="Select a recording above (or import a file). Drag the sliders to set where the loop starts and ends."
                               Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,8"
                               Visibility="{Binding HasEditorClip, Converter={StaticResource InverseBoolToVisibility}}" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="Loop start" Style="{StaticResource FieldLabel}" />
                        <Slider Minimum="0" Maximum="{Binding Duration}" Value="{Binding TrimStart}" SmallChange="0.01" LargeChange="0.25"
                                IsEnabled="{Binding HasEditorClip}" AutomationProperties.Name="Loop start" />
                        <TextBlock Text="Loop end" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                        <Slider Minimum="0" Maximum="{Binding Duration}" Value="{Binding TrimEnd}" SmallChange="0.01" LargeChange="0.25"
                                IsEnabled="{Binding HasEditorClip}" AutomationProperties.Name="Loop end" />
                        <TextBlock Text="{Binding TrimText}" Margin="0,6,0,10" Foreground="{StaticResource MutedForegroundBrush}" />
                        <WrapPanel>
                            <Button Command="{Binding PreviewSelectionCommand}" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE768;" Margin="0,0,6,0" /><TextBlock Text="Preview selection" /></StackPanel>
                            </Button>
                            <Button Command="{Binding StopPreviewCommand}" Content="Stop preview" Margin="0,0,6,6" />
                            <Button Command="{Binding SnapToBarsCommand}" Content="Snap length to whole bars" Margin="0,0,6,6"
                                    ToolTip="Makes the selection exactly N bars long at the project tempo so it loops in time" />
                            <Button Command="{Binding ResetTrimCommand}" Content="Reset" Margin="0,0,18,6" />
                            <Button Command="{Binding SaveAsSampleCommand}" Content="Save as sample" Margin="0,0,6,6" />
                            <Button Command="{Binding AddToProjectCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE710;" Margin="0,0,6,0" /><TextBlock Text="Add to project as loop track" /></StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                    <Border CornerRadius="8" ClipToBounds="True" MinHeight="140">
                        <Grid>
                            <controls:WaveformView Peaks="{Binding Peaks}" SelectionStart="{Binding SelectionStartFraction}" SelectionEnd="{Binding SelectionEndFraction}" />
                            <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsEditorBusy, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
