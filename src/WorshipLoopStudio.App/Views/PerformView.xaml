<UserControl x:Class="WorshipLoopStudio.App.Views.PerformView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,8,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sample browser ============ -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="SOUNDS" Style="{StaticResource SectionTitle}" />
                <TextBlock DockPanel.Dock="Top" Text="Instrument category" Style="{StaticResource FieldLabel}" />
                <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,0,8"
                          AutomationProperties.Name="Instrument category" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                            AutomationProperties.Name="Clear search">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" />
                    </Button>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search sounds" ToolTip="Search sounds" />
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button Command="{Binding PreviewCommand}" Margin="0,0,3,0" ToolTip="Play the selected sound">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE768;" Margin="0,0,6,0" /><TextBlock Text="Preview" /></StackPanel>
                        </Button>
                        <Button Command="{Binding StopPreviewCommand}" Content="Stop preview" Margin="3,0,0,0" />
                    </UniformGrid>
                    <Button Command="{Binding AddTrackCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE710;" Margin="0,0,6,0" /><TextBlock Text="Add as new track" /></StackPanel>
                    </Button>
                    <Button Command="{Binding AssignSampleCommand}" Content="Use for selected track" Margin="0,0,0,6" />
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Command="{Binding ImportSamplesCommand}" Content="Import files..." Margin="0,0,3,0" ToolTip="Load your own WAV, MP3, AIFF, FLAC or M4A samples" />
                        <Button Command="{Binding RefreshLibraryCommand}" Content="Refresh" Margin="3,0,0,0" />
                    </UniformGrid>
                    <TextBlock Text="Preview volume" Style="{StaticResource FieldLabel}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding PreviewVolume}" AutomationProperties.Name="Preview volume" />
                </StackPanel>

                <ListBox ItemsSource="{Binding VisibleSamples}" SelectedItem="{Binding SelectedSample}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnSampleDoubleClick"
                         AutomationProperties.Name="Sounds">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource MutedForegroundBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Transport, tempo, metronome ============ -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding PlayCommand}" Style="{StaticResource PlayButton}" Margin="0,0,8,0" ToolTip="Play (Space)"
                                    AutomationProperties.Name="Play">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="18" Margin="0,0,8,0" /><TextBlock Text="PLAY" FontSize="15" /></StackPanel>
                            </Button>
                            <Button Command="{Binding StopCommand}" Style="{StaticResource BigDangerButton}" Margin="0,0,8,0" ToolTip="Stop (Space or Esc)"
                                    AutomationProperties.Name="Stop">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" FontSize="18" Margin="0,0,8,0" /><TextBlock Text="STOP" FontSize="15" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding StopModes}" SelectedItem="{Binding SelectedStopMode}" Margin="0,8,0,0" Width="232" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Stop behaviour" ToolTip="What Stop does" />
                        <Button Command="{Binding PanicCommand}" Content="All sound off" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                ToolTip="Immediately silence every sound" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel Margin="0,0,24,10">
                            <TextBlock Text="Tempo (BPM)" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="-5" Command="{Binding NudgeBpmCommand}" CommandParameter="-5" Margin="0,0,4,0" AutomationProperties.Name="Tempo minus 5" />
                                <Button Content="-1" Command="{Binding NudgeBpmCommand}" CommandParameter="-1" Margin="0,0,4,0" AutomationProperties.Name="Tempo minus 1" />
                                <TextBox x:Name="BpmBox" Width="72" FontSize="20" FontWeight="SemiBold" HorizontalContentAlignment="Center"
                                         Text="{Binding Bpm, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="OnBpmKeyDown"
                                         AutomationProperties.Name="Tempo in beats per minute" ToolTip="Type a tempo (30-300) and press Enter" />
                                <Button Content="+1" Command="{Binding NudgeBpmCommand}" CommandParameter="1" Margin="4,0,0,0" AutomationProperties.Name="Tempo plus 1" />
                                <Button Content="+5" Command="{Binding NudgeBpmCommand}" CommandParameter="5" Margin="4,0,0,0" AutomationProperties.Name="Tempo plus 5" />
                                <Button Content="Tap" Command="{Binding TapTempoCommand}" Margin="8,0,0,0" ToolTip="Tap in time to set the tempo" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,10">
                            <TextBlock Text="Time signature" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding TimeSignatures}" SelectedItem="{Binding SelectedTimeSignature}" Width="80" AutomationProperties.Name="Time signature" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,10">
                            <TextBlock Text="Grid (quantize)" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Quantizations}" SelectedItem="{Binding SelectedQuantization}" Width="190" AutomationProperties.Name="Quantization" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,10">
                            <TextBlock Text="Loop length (bars)" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding BarOptions}" SelectedItem="{Binding Bars}" Width="64" AutomationProperties.Name="Loop length in bars" />
                                <TextBlock Text="{Binding LoopLengthText}" Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,10">
                            <TextBlock Text="Metronome" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding MetronomeEnabled}" Content="Click" Width="64" AutomationProperties.Name="Metronome on or off" />
                                <Slider Minimum="0" Maximum="1" Value="{Binding MetronomeVolume}" Width="110" Margin="8,0,0,0" VerticalAlignment="Center"
                                        AutomationProperties.Name="Metronome volume" ToolTip="Metronome volume" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,10">
                            <TextBlock Text="Count-in (bars)" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding CountInOptions}" SelectedItem="{Binding CountInBars}" Width="64" AutomationProperties.Name="Count-in bars" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,10">
                            <TextBlock Text="Pads" Style="{StaticResource FieldLabel}" />
                            <ToggleButton IsChecked="{Binding RecordPads}" Content="Record pad hits" ToolTip="While playing, pad hits (and keys 1-9) are written into the pattern at the nearest step" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Beat indicator and master meter -->
                    <StackPanel Grid.Column="2" MinWidth="200">
                        <TextBlock Text="{Binding TransportText}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCountingIn}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding PositionText}" HorizontalAlignment="Right" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,2,0,8" />
                        <ItemsControl ItemsSource="{Binding BeatLeds}" HorizontalAlignment="Right">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="28" Height="28" CornerRadius="14" Margin="3,0" BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource MutedBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAccent}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,12,0,0" HorizontalAlignment="Right" Width="200">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Height="6" Background="{StaticResource MutedBrush}" CornerRadius="3" />
                            <Border Height="6" Background="{StaticResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Left"
                                    Width="{Binding MasterLevelL, Converter={StaticResource LevelToWidth}, ConverterParameter=200}" />
                            <Border Grid.Row="1" Height="6" Margin="0,3,0,0" Background="{StaticResource MutedBrush}" CornerRadius="3" />
                            <Border Grid.Row="1" Height="6" Margin="0,3,0,0" Background="{StaticResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Left"
                                    Width="{Binding MasterLevelR, Converter={StaticResource LevelToWidth}, ConverterParameter=200}" />
                        </Grid>
                        <TextBlock Text="Master output" FontSize="11" Foreground="{StaticResource MutedForegroundBrush}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Sequencer ============ -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                        <TextBlock Text="Click a sound name to select the track. Click the cells to build the pattern. Keys 1-9 trigger tracks."
                                   DockPanel.Dock="Right" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="SEQUENCER" Style="{StaticResource SectionTitle}" Margin="0" />
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="8" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Track header -->
                                            <Grid Width="330" Margin="0,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Command="{Binding TriggerCommand}" Width="40" Height="40" Padding="0" ToolTip="Hit the pad (plays this track now)"
                                                        AutomationProperties.Name="Trigger pad">
                                                    <Grid>
                                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" HorizontalAlignment="Center" />
                                                        <Border CornerRadius="5" Background="{StaticResource AccentBrush}" Opacity="{Binding Level}" IsHitTestVisible="False" Width="30" Height="30" />
                                                    </Grid>
                                                </Button>
                                                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                                    <Button Command="{Binding SelectCommand}" Style="{StaticResource GhostButton}" Padding="2,0" MinHeight="22"
                                                            HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" ToolTip="Select this track">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                    <TextBlock Text="{Binding SampleName}" FontSize="11" Foreground="{StaticResource MutedForegroundBrush}" Margin="2,0,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="2,0,0,0"
                                                               Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding Mute}" Margin="0,0,4,0" AutomationProperties.Name="Mute track" />
                                                    <ToggleButton Style="{StaticResource SoloToggle}" IsChecked="{Binding Solo}" Margin="0,0,4,0" AutomationProperties.Name="Solo track" />
                                                    <ToggleButton IsChecked="{Binding IsAudioLoop}" Content="Loop" Padding="6,4" Margin="0,0,4,0"
                                                                  ToolTip="Audio loop mode: the whole clip restarts at the start of every loop instead of following the step pattern" />
                                                    <Button Command="{Binding ClearCommand}" Style="{StaticResource GhostButton}" ToolTip="Clear the pattern" AutomationProperties.Name="Clear pattern">
                                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE894;" />
                                                    </Button>
                                                    <Button Command="{Binding RemoveCommand}" Style="{StaticResource GhostButton}" ToolTip="Remove track" AutomationProperties.Name="Remove track">
                                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Steps -->
                                            <ItemsControl ItemsSource="{Binding Steps}" VerticalAlignment="Center"
                                                          Visibility="{Binding IsPattern, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Style="{StaticResource StepToggle}" IsChecked="{Binding IsOn}" Margin="{Binding CellMargin}"
                                                                      ToolTip="{Binding ToolTipText}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Audio loop: the clip restarts at the beginning of every loop cycle, in sync with the other tracks."
                                                       VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}"
                                                       Visibility="{Binding IsAudioLoop, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ Mixer ============ -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MIXER" Style="{StaticResource SectionTitle}" Margin="4,0,0,8" />
                    <Border DockPanel.Dock="Right" Width="110" Margin="8,0,0,0" Padding="8" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="MASTER" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <Slider Orientation="Vertical" Height="120" Minimum="0" Maximum="1.5" Value="{Binding MasterVolume}" HorizontalAlignment="Center"
                                    AutomationProperties.Name="Master volume" />
                            <TextBlock Text="{Binding MasterVolume, StringFormat={}{0:P0}}" HorizontalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="104" Margin="0,0,8,0" Padding="8" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,0,0,6"
                                                       ToolTip="{Binding Name}" />
                                            <Slider Orientation="Vertical" Height="120" Minimum="0" Maximum="1.5" Value="{Binding Volume}" HorizontalAlignment="Center"
                                                    AutomationProperties.Name="Track volume" />
                                            <TextBlock Text="{Binding VolumeText}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,4,0,4" />
                                            <Slider Minimum="-1" Maximum="1" Value="{Binding Pan}" AutomationProperties.Name="Track pan" ToolTip="Pan left / right" />
                                            <TextBlock Text="{Binding PanText}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding Mute}" Margin="0,0,4,0" AutomationProperties.Name="Mute" />
                                                <ToggleButton Style="{StaticResource SoloToggle}" IsChecked="{Binding Solo}" AutomationProperties.Name="Solo" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
